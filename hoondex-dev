#!/usr/bin/env bash
# hoondex-dev — build the `hoondex` binary from source (fast incremental debug)
# and launch it, forwarding all arguments.
#
# Unlike the installed release `hoondex`, this always reflects the latest source
# in this checkout. If the build fails, it exits without launching so you never
# accidentally run a stale binary.
#
# Put it on your PATH (see the README "Running from source" section), e.g.:
#   ln -s "$(pwd)/hoondex-dev" ~/.local/bin/hoondex-dev
set -euo pipefail

# Resolve the real location of this script, following symlinks, so it works when
# symlinked onto your PATH from anywhere.
script_path="${BASH_SOURCE[0]}"
while [ -L "$script_path" ]; do
  link_target="$(readlink "$script_path")"
  case "$link_target" in
    /*) script_path="$link_target" ;;
    *) script_path="$(cd "$(dirname "$script_path")" && pwd)/$link_target" ;;
  esac
done
repo_root="$(cd "$(dirname "$script_path")" && pwd)"

cd "$repo_root/codex-rs"
cargo build --bin hoondex
exec "$repo_root/codex-rs/target/debug/hoondex" "$@"
